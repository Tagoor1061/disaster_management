# ============================================================================
# SURAKSHA KAVACH - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# Copy this file to .env for local development.
# In production on Render, add these variables in the Render Dashboard -> Environment.

# ----------------------------------------------------------------------------
# 1. FLASK CORE CONFIGURATION
# ----------------------------------------------------------------------------
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Leave blank locally for SQLite (instance/guntur.db) or provide PostgreSQL URL in production:
# Example: postgresql://username:password@host:5432/dbname
DATABASE_URL=

# ----------------------------------------------------------------------------
# 2. GEOGRAPHIC / WEATHER LOCATION CONFIGURATION
# ----------------------------------------------------------------------------
# Location details for weather forecasts & municipal monitoring
WEATHER_CITY=Guntur
WEATHER_LATITUDE=16.3067
WEATHER_LONGITUDE=80.4365

# Optional OpenWeatherMap API key (if blank, app falls back to Open-Meteo)
OPENWEATHER_API_KEY=

# ----------------------------------------------------------------------------
# 3. OFFICIAL METEOROLOGICAL & SATELLITE APIS (IMD & ISRO / MOSDAC)
# ----------------------------------------------------------------------------
# India Meteorological Department (IMD) OAuth & API Key Configuration
IMD_EMAIL=
IMD_PASSWORD=
IMD_API_KEY=

# Space Applications Centre (ISRO / MOSDAC) Satellite Configuration
MOSDAC_API_KEY=
MOSDAC_USERNAME=
MOSDAC_PASSWORD=

# ----------------------------------------------------------------------------
# 4. NEWS API CONFIGURATION
# ----------------------------------------------------------------------------
# Optional NewsAPI.org key (if blank, uses database news & fallback feed)
NEWS_API_KEY=

# ----------------------------------------------------------------------------
# 5. BROWSER PUSH NOTIFICATIONS (Web Push / VAPID)
# ----------------------------------------------------------------------------
# Generate VAPID keypair using: python -c "import py_vapid; ..." or https://web-push-codelab.glitch.me/
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@gunturmunicipal.com

# ----------------------------------------------------------------------------
# 6. MAIL SERVER CONFIGURATION (SMTP)
# ----------------------------------------------------------------------------
# Optional SMTP configuration for email alerts
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=Guntur Municipal Corporation <info@municipalcorporation.gov>

# ----------------------------------------------------------------------------
# 7. SMS GATEWAY CONFIGURATIONS (Optional)
# ----------------------------------------------------------------------------
# Fast2SMS API Key (Optional)
SMS_API_KEY=

# Twilio SMS Credentials (Optional fallback)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
