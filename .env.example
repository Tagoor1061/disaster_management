# Flask Configuration
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret
DATABASE_URL=sqlite:///guntur.db

# ============================================================================
# WEATHER API CONFIGURATION
# ============================================================================
# Optional. If omitted, weather uses Open-Meteo (free, no API key required)
# Get your API key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Weather Location (Default: Guntur, Andhra Pradesh)
WEATHER_CITY=Guntur
WEATHER_LATITUDE=16.3067
WEATHER_LONGITUDE=80.4365

# ============================================================================
# OFFICIAL METEOROLOGICAL & SATELLITE APIS (IMD & ISRO / MOSDAC)
# ============================================================================
# India Meteorological Department (IMD) OAuth & API Key Configuration
# Token Endpoint: https://api.imd.gov.in/api/oauth/token.php
# Required for live cyclone tracking, wind warnings (27/34/50/64 kt), and COU
IMD_EMAIL=
IMD_PASSWORD=
IMD_API_KEY=

# Space Applications Centre (ISRO / MOSDAC) Satellite Configuration
MOSDAC_API_KEY=
MOSDAC_USERNAME=
MOSDAC_PASSWORD=

# ============================================================================
# NEWS API CONFIGURATION
# ============================================================================
# Optional. If omitted, news uses local database records and fallback message
# Get your API key from: https://newsapi.org
NEWS_API_KEY=

# ============================================================================
